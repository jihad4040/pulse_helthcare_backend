// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId         String        @id @default(uuid())
  name           String
  email          String        @unique
  password       String
  role           Role          @default(USER)
  profile        String?
  otp            String?
  refreshToken   String?
  isNotification Boolean       @default(true)
  isAgree        Boolean       @default(false)
  isOnboarded    Boolean       @default(false)
  verifidStatus  verifidStatus @default(PENDING)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  onboarding Onboarding?

  @@map("users")
}


model Onboarding {
  id          String         @id @default(uuid())
  userId      String         @unique
  name        String?
  step        OnboardingStep @default(NAME)
  isCompleted Boolean        @default(false)

  user          User             @relation(fields: [userId], references: [userId])
  selectedItems SelectedMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


model CategoryMetric {
  id          String  @id @default(uuid())
  label       String
  description String?
  icon        String?

  metrics Metric[]

  createdAt DateTime @default(now())
}


model Metric {
  id         String @id @default(uuid())
  categoryId String
  label      String
  data       Json?

  category   CategoryMetric   @relation(fields: [categoryId], references: [id])
  selectedBy SelectedMetric[]

  createdAt DateTime @default(now())

  @@index([categoryId])
}



model SelectedMetric {
  id           String @id @default(uuid())
  onboardingId String
  metricId     String

  onboarding Onboarding @relation(fields: [onboardingId], references: [id])
  metric     Metric     @relation(fields: [metricId], references: [id])

  createdAt DateTime @default(now())

  @@unique([onboardingId, metricId])
  @@index([onboardingId])
  @@index([metricId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum verifidStatus {
  SUSPEND
  INACTIVE
  ACTIVE
  PENDING
}

enum OnboardingStep {
  NAME
  CATEGORY
  METRICS
  COMPLETE
}
