generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId         String        @id @default(uuid())
  name           String
  email          String        @unique
  phone          String        @unique
  password       String
  role           Role          @default(USER)
  profile        String?
  otp            String?
  refreshToken   String?
  isNotification Boolean       @default(true)
  isAgree        Boolean       @default(false)
  isOnboarded    Boolean       @default(false)
  verifidStatus  verifidStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum verifidStatus {
  SUSPEND
  INACTIVE
  ACTIVE
  PENDING
}
